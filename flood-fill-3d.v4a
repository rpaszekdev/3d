-- FILM-TITLE: "3D Flood Fill — Wave Propagation Through Tunnels"
-- FILM: 0 5 "The Structure" "A complex 3D maze with chambers, tunnels, and dead ends materializes — thick walls define the internal geometry."
-- FILM: 5 9 "The Seed" "A **bright seed** ignites in the central chamber, pulsing with energy, ready to flood the void."
-- FILM: 9 18 "The Fill Wave" "The fill **propagates outward** like fluid — flowing through tunnels, branching at junctions, respecting every wall."
-- FILM: 18 23 "Hitting Walls" "The wave **splashes** against dead ends and outer boundaries — ripple effects mark the limits of reachable space."
-- FILM: 23 28 "Connected Component" "The filled volume glows as **one connected region**. An isolated cavity gets a second color — proof that flood fill finds components."
V 96 56 56
DUR 28
L 1

-- ============================================
-- STAGE 1: THE STRUCTURE (T=0-5)
-- Thick walls with internal tunnels/chambers
-- Center of grid ~(0, 0, 0)
-- ============================================

-- OUTER SHELL — four partial walls so interior is visible
-- Back wall (full, gives depth)
B 0 0 26 clamp(T*1.5,0,1)*60 clamp(T*1.5,0,1)*36 clamp(T*1.2,0,1)*2 9
-- Floor
B 0 -17 0 clamp(T*1.5-0.1,0,1)*60 clamp(T*1.5-0.1,0,1)*2 clamp(T*1.5-0.1,0,1)*50 9
-- Ceiling
B 0 17 0 clamp(T*1.5-0.15,0,1)*60 clamp(T*1.5-0.15,0,1)*2 clamp(T*1.5-0.15,0,1)*50 9
-- Left wall (partial — lower half only so we can see inside)
B -29 -5 0 clamp(T*1.5-0.2,0,1)*2 clamp(T*1.5-0.2,0,1)*22 clamp(T*1.5-0.2,0,1)*50 9
-- Right wall (partial — lower half only)
B 29 -5 0 clamp(T*1.5-0.25,0,1)*2 clamp(T*1.5-0.25,0,1)*22 clamp(T*1.5-0.25,0,1)*50 9
-- Front wall (partial — left strip only, leaving right open as viewport)
B -20 0 -26 clamp(T*1.5-0.3,0,1)*18 clamp(T*1.5-0.3,0,1)*36 clamp(T*1.5-0.3,0,1)*2 9

-- INTERNAL WALLS — creating chambers and tunnels

-- Central chamber walls (box frame around center, with openings)
-- Left wall of central chamber (with gap at Y=0 for tunnel)
B -12 10 0 clamp(T-1,0,1)*2 clamp(T-1,0,1)*12 clamp(T-1,0,1)*20 9
B -12 -10 0 clamp(T-1.1,0,1)*2 clamp(T-1.1,0,1)*12 clamp(T-1.1,0,1)*20 9
-- Right wall of central chamber (with gap at Y=0 for tunnel)
B 12 10 0 clamp(T-1.2,0,1)*2 clamp(T-1.2,0,1)*12 clamp(T-1.2,0,1)*20 9
B 12 -10 0 clamp(T-1.3,0,1)*2 clamp(T-1.3,0,1)*12 clamp(T-1.3,0,1)*20 9

-- Top wall of central chamber (with gap at X=0 for upward tunnel)
B -8 5 0 clamp(T-1.4,0,1)*6 clamp(T-1.4,0,1)*2 clamp(T-1.4,0,1)*20 9
B 8 5 0 clamp(T-1.5,0,1)*6 clamp(T-1.5,0,1)*2 clamp(T-1.5,0,1)*20 9

-- LEFT TUNNEL walls (horizontal corridor going left from center)
B -20 3 0 clamp(T-2,0,1)*14 clamp(T-2,0,1)*2 clamp(T-2,0,1)*12 9
B -20 -3 0 clamp(T-2.1,0,1)*14 clamp(T-2.1,0,1)*2 clamp(T-2.1,0,1)*12 9
-- Left tunnel ceiling
B -20 3 0 clamp(T-2.15,0,1)*14 clamp(T-2.15,0,1)*2 clamp(T-2.15,0,1)*12 9

-- RIGHT TUNNEL walls (horizontal corridor going right from center)
B 20 3 0 clamp(T-2.3,0,1)*14 clamp(T-2.3,0,1)*2 clamp(T-2.3,0,1)*12 9
B 20 -3 0 clamp(T-2.4,0,1)*14 clamp(T-2.4,0,1)*2 clamp(T-2.4,0,1)*12 9
-- Right tunnel dead-end wall
B 27 0 0 clamp(T-2.6,0,1)*2 clamp(T-2.6,0,1)*8 clamp(T-2.6,0,1)*12 9

-- UPWARD TUNNEL walls (vertical shaft going up from center)
B -3 11 0 clamp(T-3,0,1)*2 clamp(T-3,0,1)*10 clamp(T-3,0,1)*10 9
B 3 11 0 clamp(T-3.1,0,1)*2 clamp(T-3.1,0,1)*10 clamp(T-3.1,0,1)*10 9

-- DEAD-END CAVITY (small room branching off the left tunnel, going backward in Z)
B -22 0 10 clamp(T-3.5,0,1)*6 clamp(T-3.5,0,1)*8 clamp(T-3.5,0,1)*2 9
B -22 0 18 clamp(T-3.6,0,1)*6 clamp(T-3.6,0,1)*8 clamp(T-3.6,0,1)*2 9
B -25 0 14 clamp(T-3.7,0,1)*2 clamp(T-3.7,0,1)*8 clamp(T-3.7,0,1)*8 9
B -19 0 14 clamp(T-3.8,0,1)*2 clamp(T-3.8,0,1)*8 clamp(T-3.8,0,1)*8 9

-- ISOLATED CAVITY (separate from main structure — upper right, unreachable)
B 22 12 -10 clamp(T-4,0,1)*8 clamp(T-4,0,1)*6 clamp(T-4,0,1)*8 9
-- Inner void marked by thin walls all around
B 22 12 -6 clamp(T-4.2,0,1)*6 clamp(T-4.2,0,1)*4 clamp(T-4.2,0,1)*1 9
B 22 12 -14 clamp(T-4.3,0,1)*6 clamp(T-4.3,0,1)*4 clamp(T-4.3,0,1)*1 9

-- ============================================
-- STAGE 2: THE SEED (T=5-9)
-- Pulsing bright seed at center of main chamber
-- ============================================

-- Main seed sphere (pulsing yellow/white)
S 0 0 0 clamp(T-5,0,1)*(2+sin(T*8)*0.8) 6
S 0 0 0 clamp(T-5.2,0,1)*(1.5+cos(T*10)*0.5) 8
-- Seed glow halo
S 0 0 0 clamp(T-5.5,0,1)*(3+sin(T*6)*1) 6

-- Sparkle particles orbiting the seed
S sin(T*4)*4 cos(T*4)*4 0 clamp(T-6,0,1)*clamp(9-T,0,1)*1 8
S cos(T*5)*3 0 sin(T*5)*3 clamp(T-6.2,0,1)*clamp(9-T,0,1)*1 8
S 0 sin(T*3)*4 cos(T*3)*4 clamp(T-6.4,0,1)*clamp(9-T,0,1)*1 6
S sin(T*6)*3 cos(T*3)*2 sin(T*4)*3 clamp(T-6.6,0,1)*clamp(9-T,0,1)*1 6
S cos(T*3)*5 sin(T*5)*3 cos(T*6)*2 clamp(T-6.8,0,1)*clamp(9-T,0,1)*1 8
S sin(T*7)*2 cos(T*6)*5 sin(T*2)*3 clamp(T-7,0,1)*clamp(9-T,0,1)*1 6

-- Energy rings expanding from seed
S 0 0 0 clamp(T-7,0,1)*clamp(9-T,0,1)*(4+saw(T*2)*3) 6
S 0 0 0 clamp(T-7.5,0,1)*clamp(9-T,0,1)*(3+saw(T*2+0.5)*3) 6

-- ============================================
-- STAGE 3: THE FILL WAVE (T=9-18)
-- Fill propagates from seed (0,0,0) outward
-- Speed factor: ~0.4 seconds per unit distance
-- ============================================

-- CENTRAL CHAMBER FILL (expanding sphere from center)
-- The chamber spans roughly (-12 to 12) in X, (-5 to 5) in Y
S 0 0 0 clamp(T-9,0,12)*1.2 4
S 0 0 0 clamp(T-9.1,0,10)*1.1 4
S 0 0 0 clamp(T-9.2,0,8)*1.0 2

-- Fill wave front ring (visual effect)
S 0 0 0 clamp(T-9,0,1)*(3+clamp(T-9,0,6)*1.8) 4
S 0 0 0 clamp(T-9.5,0,1)*(2+clamp(T-9.5,0,5)*2) 2

-- Chamber filling up — layered spheres for volume
S 0 -2 0 clamp(T-9.3,0,1)*clamp(T-9.3,0,10) 4
S 0 2 0 clamp(T-9.4,0,1)*clamp(T-9.4,0,10) 4
S 0 0 -3 clamp(T-9.5,0,1)*clamp(T-9.5,0,9) 2
S 0 0 3 clamp(T-9.6,0,1)*clamp(T-9.6,0,9) 2
S -4 0 0 clamp(T-9.8,0,1)*clamp(T-9.8,0,7) 4
S 4 0 0 clamp(T-9.9,0,1)*clamp(T-9.9,0,7) 4
S -3 -2 -2 clamp(T-9.7,0,1)*clamp(T-9.7,0,6) 2
S 3 2 2 clamp(T-9.8,0,1)*clamp(T-9.8,0,6) 2

-- Main chamber volume fill (box that grows to fill the chamber void)
B 0 0 0 clamp(T-9,0,1)*clamp(T-9,0,3)*7 clamp(T-9.2,0,1)*clamp(T-9.2,0,2.5)*3.5 clamp(T-9.1,0,1)*clamp(T-9.1,0,3)*6 4

-- FLOW INTO LEFT TUNNEL (starts at T~10.5 when wave reaches X=-12)
-- Distance from seed to left tunnel entrance: ~12 units → delay ~1.5s
-- Fill segments along left tunnel
S -13 0 0 clamp(T-10.5,0,1)*3 4
S -15 0 0 clamp(T-10.8,0,1)*3 4
S -17 0 0 clamp(T-11.1,0,1)*3 2
S -19 0 0 clamp(T-11.4,0,1)*3 4
S -21 0 0 clamp(T-11.7,0,1)*3 2
S -23 0 0 clamp(T-12.0,0,1)*3 4
S -25 0 0 clamp(T-12.3,0,1)*3 4
S -27 0 0 clamp(T-12.6,0,1)*3 2

-- Left tunnel fill volume (growing box)
B -18 0 0 clamp(T-10.5,0,1)*clamp(T-10.5,0,4)*3.5 clamp(T-10.5,0,1)*4 clamp(T-10.5,0,1)*8 4

-- Wave front glow in left tunnel
S -12-clamp(T-10.5,0,4)*3.5 0 0 clamp(T-10.5,0,1)*clamp(15-T,0,1)*2 2

-- FLOW INTO RIGHT TUNNEL (starts at T~10.5)
S 13 0 0 clamp(T-10.5,0,1)*3 4
S 15 0 0 clamp(T-10.8,0,1)*3 2
S 17 0 0 clamp(T-11.1,0,1)*3 4
S 19 0 0 clamp(T-11.4,0,1)*3 4
S 21 0 0 clamp(T-11.7,0,1)*3 2
S 23 0 0 clamp(T-12.0,0,1)*3 4
S 25 0 0 clamp(T-12.3,0,1)*3 4

-- Right tunnel fill volume
B 18 0 0 clamp(T-10.5,0,1)*clamp(T-10.5,0,3.5)*3.2 clamp(T-10.5,0,1)*4 clamp(T-10.5,0,1)*8 2

-- Wave front glow in right tunnel
S 12+clamp(T-10.5,0,3.5)*3.5 0 0 clamp(T-10.5,0,1)*clamp(14-T,0,1)*2 4

-- FLOW INTO UPWARD TUNNEL (starts at T~10.2 when wave reaches Y=5)
S 0 6 0 clamp(T-10.2,0,1)*3 2
S 0 8 0 clamp(T-10.6,0,1)*3 4
S 0 10 0 clamp(T-11.0,0,1)*3 2
S 0 12 0 clamp(T-11.4,0,1)*3 4
S 0 14 0 clamp(T-11.8,0,1)*3 2
S 0 16 0 clamp(T-12.2,0,1)*3 4

-- Upward tunnel fill volume
B 0 10 0 clamp(T-10.2,0,1)*4 clamp(T-10.2,0,1)*clamp(T-10.2,0,3)*3 clamp(T-10.2,0,1)*6 4

-- Wave front glow going up
S 0 5+clamp(T-10.2,0,3)*3.5 0 clamp(T-10.2,0,1)*clamp(14-T,0,1)*2 2

-- FLOW INTO DEAD-END CAVITY (branches off left tunnel at X=-22, Z=10)
-- Distance from seed: ~24 units → delay ~3s from fill start
S -22 0 11 clamp(T-13,0,1)*2 4
S -22 0 13 clamp(T-13.3,0,1)*2 2
S -22 0 15 clamp(T-13.6,0,1)*2 4
S -22 0 17 clamp(T-13.9,0,1)*2 2
S -22 2 14 clamp(T-14.2,0,1)*2 4
S -22 -2 14 clamp(T-14.4,0,1)*2 2

-- Dead-end cavity fill volume
B -22 0 14 clamp(T-13,0,1)*4 clamp(T-13.3,0,1)*5 clamp(T-13,0,1)*clamp(T-13,0,2)*3 4

-- Additional wave detail — fill edges along chamber corners
S -8 -3 -5 clamp(T-10,0,1)*2 2
S 8 -3 -5 clamp(T-10.1,0,1)*2 4
S -8 3 5 clamp(T-10.2,0,1)*2 4
S 8 3 5 clamp(T-10.3,0,1)*2 2
S -5 -3 8 clamp(T-10.4,0,1)*2 4
S 5 -3 8 clamp(T-10.5,0,1)*2 2
S -5 3 -8 clamp(T-10.6,0,1)*2 2
S 5 3 -8 clamp(T-10.7,0,1)*2 4

-- Turbulence detail in fill wave — small particles at wave front
S -12-clamp(T-10.5,0,3)*3+sin(T*8)*1 sin(T*6)*2 cos(T*5)*2 clamp(T-10.5,0,1)*clamp(15-T,0,1)*1 8
S 12+clamp(T-10.5,0,3)*3+cos(T*7)*1 cos(T*5)*2 sin(T*6)*2 clamp(T-10.5,0,1)*clamp(15-T,0,1)*1 8
S sin(T*5)*1 5+clamp(T-10.2,0,3)*3+cos(T*8)*1 sin(T*4)*2 clamp(T-10.2,0,1)*clamp(14-T,0,1)*1 8

-- ============================================
-- STAGE 4: HITTING WALLS (T=18-23)
-- Splash effects at dead ends and boundaries
-- ============================================

-- RIGHT TUNNEL dead-end splash (wall at X=27)
S 26 0 0 clamp(T-13,0,1)*(2+bounce(T*4)*clamp(T-13,0,1)*clamp(19-T,0,1)*3) 6
S 26 2 0 clamp(T-13.5,0,1)*clamp(20-T,0,1)*2 6
S 26 -2 0 clamp(T-13.5,0,1)*clamp(20-T,0,1)*2 6
S 26 0 3 clamp(T-13.6,0,1)*clamp(20-T,0,1)*2 6
S 26 0 -3 clamp(T-13.7,0,1)*clamp(20-T,0,1)*2 6

-- Dead-end splash in cavity (Z=18 wall)
S -22 0 17 clamp(T-15,0,1)*(1+bounce(T*5)*clamp(T-15,0,1)*clamp(21-T,0,1)*2) 6
S -22 2 17 clamp(T-15.3,0,1)*clamp(21-T,0,1)*1.5 6
S -22 -2 17 clamp(T-15.4,0,1)*clamp(21-T,0,1)*1.5 6

-- Top of upward tunnel splash (ceiling at Y=17)
S 0 16 0 clamp(T-12.5,0,1)*(1+bounce(T*6)*clamp(T-12.5,0,1)*clamp(20-T,0,1)*2) 6
S 2 16 0 clamp(T-12.8,0,1)*clamp(20-T,0,1)*1.5 6
S -2 16 0 clamp(T-12.9,0,1)*clamp(20-T,0,1)*1.5 6
S 0 16 2 clamp(T-13,0,1)*clamp(20-T,0,1)*1.5 6

-- Left tunnel end splash (outer wall at X=-28)
S -27 0 0 clamp(T-13,0,1)*(1+bounce(T*4)*clamp(T-13,0,1)*clamp(20-T,0,1)*2) 6
S -27 2 0 clamp(T-13.3,0,1)*clamp(20-T,0,1)*1.5 6
S -27 -2 0 clamp(T-13.4,0,1)*clamp(20-T,0,1)*1.5 6

-- Wall impact ripple rings (expanding then fading)
-- Right dead-end ripple
S 27 0 0 clamp(T-18,0,1)*clamp(21-T,0,1)*(2+saw(T-18)*4) 6
-- Left end ripple
S -28 0 0 clamp(T-18.5,0,1)*clamp(21.5-T,0,1)*(2+saw(T-18.5)*4) 6
-- Top ripple
S 0 17 0 clamp(T-19,0,1)*clamp(22-T,0,1)*(2+saw(T-19)*3) 6
-- Cavity ripple
S -22 0 18 clamp(T-19.5,0,1)*clamp(22.5-T,0,1)*(1+saw(T-19.5)*3) 6

-- Pressure wave bouncing back from right dead-end
S 25-clamp(T-19,0,2)*3 0 0 clamp(T-19,0,1)*clamp(21-T,0,1)*2 6
S 24-clamp(T-19.3,0,2)*3 0 0 clamp(T-19.3,0,1)*clamp(21.3-T,0,1)*2 6

-- Pressure wave bouncing back from top
S 0 15-clamp(T-19.5,0,2)*3 0 clamp(T-19.5,0,1)*clamp(21.5-T,0,1)*2 6

-- ============================================
-- STAGE 5: COMPLETE — CONNECTED COMPONENT (T=23-28)
-- Full volume glows, isolated cavity gets different color
-- ============================================

-- Complete fill glow — all tunnels pulse together as one connected region
-- Central chamber steady glow
B 0 0 0 clamp(T-18,0,1)*22 clamp(T-18,0,1)*8 clamp(T-18,0,1)*16 4
-- Left tunnel steady
B -20 0 0 clamp(T-18,0,1)*12 clamp(T-18,0,1)*4 clamp(T-18,0,1)*8 4
-- Right tunnel steady
B 18 0 0 clamp(T-18,0,1)*10 clamp(T-18,0,1)*4 clamp(T-18,0,1)*8 2
-- Upward tunnel steady
B 0 10 0 clamp(T-18,0,1)*4 clamp(T-18,0,1)*10 clamp(T-18,0,1)*6 4
-- Cavity steady
B -22 0 14 clamp(T-18,0,1)*4 clamp(T-18,0,1)*5 clamp(T-18,0,1)*6 2

-- Unified pulse (all filled regions breathe together showing connectivity)
S 0 0 0 clamp(T-23,0,1)*(8+sin(T*3)*2) 4
S -20 0 0 clamp(T-23,0,1)*(5+sin(T*3)*1.5) 4
S 20 0 0 clamp(T-23,0,1)*(5+sin(T*3)*1.5) 2
S 0 12 0 clamp(T-23,0,1)*(4+sin(T*3)*1) 4
S -22 0 14 clamp(T-23,0,1)*(3+sin(T*3)*1) 2

-- ISOLATED CAVITY — second seed appears (RED, showing disconnected component)
S 22 12 -10 clamp(T-24,0,1)*(2+sin(T*8)*0.5) 1
S 22 12 -10 clamp(T-24.3,0,1)*(1+cos(T*10)*0.3) 8
-- Isolated fill (red, separate flood)
S 22 12 -10 clamp(T-24.5,0,1)*clamp(T-24.5,0,3)*1.5 1
S 22 13 -10 clamp(T-25,0,1)*2 1
S 22 11 -10 clamp(T-25.1,0,1)*2 1
S 23 12 -10 clamp(T-25.2,0,1)*2 e
S 21 12 -10 clamp(T-25.3,0,1)*2 e
S 22 12 -9 clamp(T-25.4,0,1)*2 1
S 22 12 -11 clamp(T-25.5,0,1)*2 1
-- Isolated fill volume
B 22 12 -10 clamp(T-25,0,1)*5 clamp(T-25,0,1)*3 clamp(T-25,0,1)*5 1

-- Orbiting dots showing 3D completeness of main fill
S sin(T*1.5)*25 cos(T*1.5)*12 0 clamp(T-25,0,1)*1 8
S cos(T*1.2)*25 0 sin(T*1.2)*15 clamp(T-25.2,0,1)*1 8
S 0 sin(T*1.8)*12 cos(T*1.8)*15 clamp(T-25.4,0,1)*1 8
S sin(T*2)*20 sin(T*1.3)*10 cos(T*2)*12 clamp(T-25.6,0,1)*1 6
S cos(T*1.7)*22 cos(T*2.1)*8 sin(T*1.5)*14 clamp(T-25.8,0,1)*1 6

-- Walls become thinner (reveal fill) — replace thick walls with thinner versions
-- Thin overlay walls (lighter grey on top of structure to show transparency effect)
B -12 0 0 clamp(T-24,0,1)*1 clamp(T-24,0,1)*18 clamp(T-24,0,1)*16 9
B 12 0 0 clamp(T-24,0,1)*1 clamp(T-24,0,1)*18 clamp(T-24,0,1)*16 9

-- Label text hint — connected component marker dots
-- "1" marker near main fill
S 0 -14 -20 clamp(T-26,0,1)*2 4
-- "2" marker near isolated fill
S 22 5 -20 clamp(T-26.5,0,1)*2 1

-- Final flourish — sparkles across the filled volume
S sin(T*11)*10 cos(T*13)*4 sin(T*7)*8 clamp(T-26,0,1)*1 8
S cos(T*9)*15 sin(T*11)*3 cos(T*8)*6 clamp(T-26.2,0,1)*1 8
S sin(T*7)*8 cos(T*9)*4 sin(T*12)*10 clamp(T-26.4,0,1)*1 8
S cos(T*13)*12 sin(T*7)*3 cos(T*11)*5 clamp(T-26.6,0,1)*1 8
S sin(T*8)*18 cos(T*12)*4 sin(T*9)*7 clamp(T-26.8,0,1)*1 8
S cos(T*10)*6 sin(T*8)*5 cos(T*14)*9 clamp(T-27,0,1)*1 6
