# Person sitting at a desk with a monitor
scene 500x400 stroke:#333 stroke-width:2

group "desk" at:250,300
  rect -90,-5 180,10 rx:2
  line -80,5 -80,60
  line 80,5 80,60
end

group "monitor" at:250,250
  rect -45,-35 90,55 rx:3
  rect -6,20 12,20
  rect -20,40 40,6 rx:2
end

group "person" at:250,220
  circle 0,-55 16
  line 0,-39 0,0
  path "M 0,-25 Q -25,-10 -40,10"
  path "M 0,-25 Q 25,-10 40,10"
  line -8,0 -20,40
  line 8,0 20,40
end

animate person rotate:-2->2 duration:2s loop ease:ease-in-out
entrance desk draw-on duration:1s
entrance monitor draw-on duration:0.8s delay:0.5s
entrance person fade-in duration:0.6s delay:1s
