# scene 700x450 style:line-art stroke:#333 stroke-width:2

group "ground" at:0,0
  line 40,425 660,425
end

group "fence" at:0,0
  rect 95,192 22,232 rx:2
  rect 342,192 22,232 rx:2
  rect 588,192 22,232 rx:2
  rect 95,205 516,18 rx:2
  rect 95,275 516,18 rx:2
end

group "pickets" at:0,0
  rect 133,223 13,130 rx:1
  rect 160,223 13,130 rx:1
  rect 187,223 13,130 rx:1
  rect 214,223 13,130 rx:1
  rect 241,223 13,130 rx:1
  rect 268,223 13,130 rx:1
  rect 295,223 13,130 rx:1
  rect 378,223 13,130 rx:1
  rect 405,223 13,130 rx:1
  rect 432,223 13,130 rx:1
  rect 459,223 13,130 rx:1
  rect 486,223 13,130 rx:1
  rect 513,223 13,130 rx:1
  rect 540,223 13,130 rx:1
  rect 567,223 13,130 rx:1
end

group "cat" at:350,205
  ellipse 0,-25 20,28
  circle 0,-65 19
  polyline -7,-82 -17,-62 -2,-62
  polyline 7,-82 17,-62 2,-62
  circle -7,-67 3 fill:#333
  circle 7,-67 3 fill:#333
  ellipse 0,-59 3,2 fill:#333
  path "M 0,-57 Q -4,-53 -5,-51"
  path "M 0,-57 Q 4,-53 5,-51"
  line -22,-62 -9,-61
  line -21,-66 -9,-64
  line 22,-62 9,-61
  line 21,-66 9,-64
  ellipse -10,2 7,5
  ellipse 10,2 7,5
end

group "cat-tail" at:368,198
  path "M 0,0 Q 42,22 28,74"
end

animate cat-tail rotate:-12->12 duration:2s loop ease:ease-in-out
entrance fence fade-in duration:0.5s
entrance cat slide-down duration:0.6s delay:0.3s
entrance cat-tail slide-down duration:0.6s delay:0.3s