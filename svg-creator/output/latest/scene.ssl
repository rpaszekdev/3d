# Dynamic running figure - mid-stride, leaning forward

scene 700x480 stroke:#222 stroke-width:2.5

group "shadow" at:326,342
  ellipse 0,0 50,8 fill:#ddd stroke:#bbb stroke-width:1 opacity:0.5
end

group "head" at:318,98
  circle 0,0 18
  path "M -10,-10 Q 2,-28 20,-16"
end

group "neck" at:318,116
  line 0,0 4,16
end

group "torso" at:322,132
  path "M 0,0 Q 5,32 10,64"
end

group "arm-forward" at:316,145
  path "M 0,0 Q -24,-16 -38,-38"
  path "M -38,-38 Q -32,-60 -20,-72"
  circle -20,-72 5 fill:#222
end

group "arm-back" at:330,145
  path "M 0,0 Q 28,18 40,42"
  path "M 40,42 Q 44,64 36,76"
  circle 36,76 5 fill:#222
end

group "leg-forward" at:315,196
  path "M 0,0 Q -20,38 -14,75"
  path "M -14,75 Q -10,110 2,138"
  path "M 2,138 Q 12,144 22,138"
end

group "leg-back" at:328,196
  path "M 0,0 Q 24,38 38,72"
  path "M 38,72 Q 44,96 36,118"
  path "M 36,118 Q 26,126 16,120"
end

group "motion-lines" at:268,162
  line 0,0 -35,0 stroke:#bbb stroke-width:1.5 dash:6,5
  line 0,24 -48,24 stroke:#bbb stroke-width:1.5 dash:6,5
  line 0,48 -30,48 stroke:#bbb stroke-width:1.5 dash:6,5
end

animate torso translateY -2->2 duration:0.32s loop ease:ease-in-out
animate head translateY -2->2 duration:0.32s loop ease:ease-in-out
animate shadow scale 0.88->1.12 duration:0.32s loop ease:ease-in-out

entrance head fade-in duration:0.5s
entrance neck fade-in duration:0.5s delay:0.05s
entrance torso fade-in duration:0.5s delay:0.1s
entrance arm-forward slide-right duration:0.45s delay:0.15s
entrance arm-back slide-right duration:0.45s delay:0.2s
entrance leg-forward slide-right duration:0.45s delay:0.25s
entrance leg-back slide-right duration:0.45s delay:0.3s
entrance motion-lines fade-in duration:0.7s delay:0.45s
entrance shadow fade-in duration:0.4s delay:0.35s