-- FILM-TITLE: "Marching Cubes: Voxels to Meshes"
-- FILM: 0 6 "The Scalar Field" "A 3D grid of sample points — each has a density value. **Red = inside** the surface, **Blue = outside**."
-- FILM: 6 12 "One Cube — 8 Corners" "Zoom into a single cube cell. Each corner is classified **inside or outside** the isosurface threshold."
-- FILM: 12 18 "The Lookup Table" "The corner configuration maps to one of **256 cases**. Triangles are generated where the surface **intersects edges**."
-- FILM: 18 24 "March Through the Grid" "Process every cube in sequence — a **sweep plane** marches through, generating surface patches cube by cube."
-- FILM: 24 30 "The Isosurface" "All patches combine into a **smooth isosurface** — the mesh extracted from the scalar field."

V 96 56 56
DUR 30
L 1

-- ============================================
-- STAGE 1: THE SCALAR FIELD (T=0-6)
-- ============================================

-- Inside points (red/orange) forming a blob in center
S 48 28 28 clamp(T-0.0,0,1)*2.0 1
S 42 28 28 clamp(T-0.2,0,1)*2.0 7
S 54 28 28 clamp(T-0.3,0,1)*2.0 1
S 48 22 28 clamp(T-0.4,0,1)*2.0 7
S 48 34 28 clamp(T-0.5,0,1)*2.0 1
S 48 28 22 clamp(T-0.6,0,1)*2.0 7
S 48 28 34 clamp(T-0.7,0,1)*2.0 1
S 45 25 25 clamp(T-0.8,0,1)*1.8 7
S 51 31 31 clamp(T-0.9,0,1)*1.8 1
S 45 31 25 clamp(T-1.0,0,1)*1.8 7
S 51 25 31 clamp(T-1.1,0,1)*1.8 1
S 45 25 31 clamp(T-1.2,0,1)*1.8 7
S 51 31 25 clamp(T-1.3,0,1)*1.8 1
S 51 25 25 clamp(T-1.4,0,1)*1.8 7
S 45 31 31 clamp(T-1.5,0,1)*1.8 1
S 48 25 25 clamp(T-1.6,0,1)*1.5 7

-- Outside points (blue/cyan) surrounding the blob
S 30 28 28 clamp(T-0.3,0,1)*clamp(24-T,0,1)*1.5 3
S 66 28 28 clamp(T-0.5,0,1)*clamp(24-T,0,1)*1.5 4
S 48 10 28 clamp(T-0.7,0,1)*clamp(24-T,0,1)*1.5 3
S 48 46 28 clamp(T-0.9,0,1)*clamp(24-T,0,1)*1.5 4
S 48 28 10 clamp(T-1.1,0,1)*clamp(24-T,0,1)*1.5 3
S 48 28 46 clamp(T-1.3,0,1)*clamp(24-T,0,1)*1.5 4
S 30 16 28 clamp(T-1.5,0,1)*clamp(24-T,0,1)*1.5 3
S 66 40 28 clamp(T-1.7,0,1)*clamp(24-T,0,1)*1.5 4
S 30 40 28 clamp(T-1.9,0,1)*clamp(24-T,0,1)*1.5 3
S 66 16 28 clamp(T-2.1,0,1)*clamp(24-T,0,1)*1.5 4
S 30 28 16 clamp(T-2.3,0,1)*clamp(24-T,0,1)*1.5 3
S 66 28 40 clamp(T-2.5,0,1)*clamp(24-T,0,1)*1.5 4
S 30 28 40 clamp(T-2.7,0,1)*clamp(24-T,0,1)*1.5 3
S 66 28 16 clamp(T-2.9,0,1)*clamp(24-T,0,1)*1.5 4
S 20 28 28 clamp(T-3.1,0,1)*clamp(24-T,0,1)*1.5 3
S 76 28 28 clamp(T-3.3,0,1)*clamp(24-T,0,1)*1.5 4
S 48 4 28 clamp(T-3.5,0,1)*clamp(24-T,0,1)*1.5 3
S 48 52 28 clamp(T-3.7,0,1)*clamp(24-T,0,1)*1.5 4
S 48 28 4 clamp(T-3.9,0,1)*clamp(24-T,0,1)*1.5 3
S 48 28 52 clamp(T-4.1,0,1)*clamp(24-T,0,1)*1.5 4

-- ============================================
-- STAGE 2: ONE CUBE — 8 CORNERS (T=6-12)
-- ============================================

-- 8 corner spheres
S 36 18 18 clamp(T-6,0,1)*clamp(18-T,0,1)*2.5 3
S 60 18 18 clamp(T-6.2,0,1)*clamp(18-T,0,1)*2.5 3
S 36 38 18 clamp(T-6.4,0,1)*clamp(18-T,0,1)*2.5 1
S 60 38 18 clamp(T-6.6,0,1)*clamp(18-T,0,1)*2.5 1
S 36 18 38 clamp(T-6.8,0,1)*clamp(18-T,0,1)*2.5 3
S 60 18 38 clamp(T-7.0,0,1)*clamp(18-T,0,1)*2.5 1
S 36 38 38 clamp(T-7.2,0,1)*clamp(18-T,0,1)*2.5 1
S 60 38 38 clamp(T-7.4,0,1)*clamp(18-T,0,1)*2.5 1

-- Cube edges (12 edges)
B 48 18 18 24 1 1 clamp(T-7.5,0,1)*clamp(18-T,0,1)*9
B 48 18 38 24 1 1 clamp(T-7.6,0,1)*clamp(18-T,0,1)*9
B 36 18 28 1 1 20 clamp(T-7.7,0,1)*clamp(18-T,0,1)*9
B 60 18 28 1 1 20 clamp(T-7.8,0,1)*clamp(18-T,0,1)*9
B 48 38 18 24 1 1 clamp(T-7.9,0,1)*clamp(18-T,0,1)*9
B 48 38 38 24 1 1 clamp(T-8.0,0,1)*clamp(18-T,0,1)*9
B 36 38 28 1 1 20 clamp(T-8.1,0,1)*clamp(18-T,0,1)*9
B 60 38 28 1 1 20 clamp(T-8.2,0,1)*clamp(18-T,0,1)*9
B 36 28 18 1 20 1 clamp(T-8.3,0,1)*clamp(18-T,0,1)*9
B 60 28 18 1 20 1 clamp(T-8.4,0,1)*clamp(18-T,0,1)*9
B 36 28 38 1 20 1 clamp(T-8.5,0,1)*clamp(18-T,0,1)*9
B 60 28 38 1 20 1 clamp(T-8.6,0,1)*clamp(18-T,0,1)*9

-- Threshold plane
B 48 28 28 26 1 22 clamp(T-9,0,1)*clamp(12-T,0,1)*5

-- Inside corner highlights
S 36 38 18 clamp(T-10,0,1)*clamp(12-T,0,1)*abs(sin(T*4))*3.5 6
S 60 38 18 clamp(T-10,0,1)*clamp(12-T,0,1)*abs(sin(T*4))*3.5 6
S 60 18 38 clamp(T-10.2,0,1)*clamp(12-T,0,1)*abs(sin(T*4))*3.5 6
S 36 38 38 clamp(T-10.2,0,1)*clamp(12-T,0,1)*abs(sin(T*4))*3.5 6
S 60 38 38 clamp(T-10.4,0,1)*clamp(12-T,0,1)*abs(sin(T*4))*3.5 6

-- ============================================
-- STAGE 3: THE LOOKUP TABLE (T=12-18)
-- ============================================

-- Triangle edges (yellow)
B 48 33 18 20 1 1 clamp(T-12.5,0,1)*clamp(18-T,0,1)*6
B 36 33 28 1 1 18 clamp(T-13.0,0,1)*clamp(18-T,0,1)*6
B 42 33 28 14 2 1 clamp(T-13.5,0,1)*clamp(18-T,0,1)*6
B 60 28 28 1 16 1 clamp(T-14.0,0,1)*clamp(18-T,0,1)*6
B 55 33 33 10 1 1 clamp(T-14.5,0,1)*clamp(18-T,0,1)*6
B 56 28 33 1 1 10 clamp(T-15.0,0,1)*clamp(18-T,0,1)*6

-- Surface patches (yellow)
B 44 33 24 16 1 10 clamp(T-13.0,0,1)*clamp(18-T,0,1)*6
B 55 30 30 8 5 8 clamp(T-14.5,0,1)*clamp(18-T,0,1)*6

-- Interpolation dots
S 48 18 28 clamp(T-15,0,1)*clamp(18-T,0,1)*bounce(clamp((T-15)*3,0,PI))*2 8
S 60 28 28 clamp(T-15.3,0,1)*clamp(18-T,0,1)*bounce(clamp((T-15.3)*3,0,PI))*2 8
S 48 38 28 clamp(T-15.6,0,1)*clamp(18-T,0,1)*bounce(clamp((T-15.6)*3,0,PI))*2 8
S 36 28 28 clamp(T-15.9,0,1)*clamp(18-T,0,1)*bounce(clamp((T-15.9)*3,0,PI))*2 8
S 48 28 38 clamp(T-16.2,0,1)*clamp(18-T,0,1)*bounce(clamp((T-16.2)*3,0,PI))*2 8

-- Case number dots
P 70 44 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 72 44 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 74 44 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 70 42 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 70 40 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 72 40 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 74 40 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 74 38 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 70 36 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 72 36 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8
P 74 36 28 clamp(T-13,0,1)*clamp(18-T,0,1)*8

-- ============================================
-- STAGE 4: MARCH THROUGH THE GRID (T=18-24)
-- ============================================

-- Sweeping indicator plane
B lerp(10,86,clamp((T-18)/5,0,1)) 28 28 2 40 40 clamp(T-18,0,1)*clamp(24-T,0,1)*4

-- Surface patches appearing as sweep passes
B 30 28 28 6 6 1 clamp(T-18.5,0,1)*6
B 36 22 28 6 6 1 clamp(T-19.0,0,1)*6
B 36 34 28 6 6 1 clamp(T-19.2,0,1)*6
B 36 28 22 6 1 6 clamp(T-19.4,0,1)*6
B 36 28 34 6 1 6 clamp(T-19.6,0,1)*6
B 42 18 28 6 4 1 clamp(T-19.8,0,1)*6
B 42 38 28 6 4 1 clamp(T-20.0,0,1)*6
B 42 28 18 6 1 4 clamp(T-20.2,0,1)*6
B 42 28 38 6 1 4 clamp(T-20.4,0,1)*6
B 42 22 22 6 4 4 clamp(T-20.0,0,1)*6
B 42 34 34 6 4 4 clamp(T-20.2,0,1)*6
B 42 22 34 6 4 4 clamp(T-20.4,0,1)*6
B 42 34 22 6 4 4 clamp(T-20.6,0,1)*6
B 48 16 28 6 2 1 clamp(T-20.8,0,1)*6
B 48 40 28 6 2 1 clamp(T-21.0,0,1)*6
B 48 28 16 6 1 2 clamp(T-21.2,0,1)*6
B 48 28 40 6 1 2 clamp(T-21.4,0,1)*6
B 54 18 28 6 4 1 clamp(T-21.6,0,1)*6
B 54 38 28 6 4 1 clamp(T-21.8,0,1)*6
B 54 28 18 6 1 4 clamp(T-22.0,0,1)*6
B 54 28 38 6 1 4 clamp(T-22.2,0,1)*6
B 54 22 22 6 4 4 clamp(T-22.0,0,1)*6
B 54 34 34 6 4 4 clamp(T-22.2,0,1)*6
B 54 22 34 6 4 4 clamp(T-22.4,0,1)*6
B 54 34 22 6 4 4 clamp(T-22.6,0,1)*6
B 60 22 28 6 6 1 clamp(T-22.8,0,1)*6
B 60 34 28 6 6 1 clamp(T-23.0,0,1)*6
B 60 28 22 6 1 6 clamp(T-23.2,0,1)*6
B 60 28 34 6 1 6 clamp(T-23.4,0,1)*6
B 66 28 28 6 6 1 clamp(T-23.6,0,1)*6

-- ============================================
-- STAGE 5: THE ISOSURFACE (T=24-30)
-- ============================================

-- Complete isosurface
D 48 16 28 28 24 28 clamp(T-24,0,1)*6

-- Sparkle effects
S 48+18*cos(T*2) 28+18*sin(T*2) 28 clamp(T-24.5,0,1)*abs(sin(T*6))*1.5 8
S 48+16*cos(T*2.5+1) 28 28+16*sin(T*2.5+1) clamp(T-25,0,1)*abs(sin(T*5))*1.5 8
S 48 28+17*cos(T*1.8+2) 28+17*sin(T*1.8+2) clamp(T-25.5,0,1)*abs(sin(T*7))*1.5 6
S 48+15*cos(T*3+3) 28+15*sin(T*3+3) 28+8*sin(T*2) clamp(T-26,0,1)*abs(sin(T*4))*1.5 8
S 48+14*sin(T*2.2) 28+14*cos(T*2.2) 28+14*sin(T*1.5) clamp(T-26.5,0,1)*abs(sin(T*5.5))*1.2 6
S 48+20*cos(T*1.5) 28+12*sin(T*3) 28+12*cos(T*2.5) clamp(T-27,0,1)*abs(sin(T*8))*1.0 8
S 48+12*sin(T*2.8) 28+20*cos(T*1.2) 28+12*sin(T*3.2) clamp(T-27.5,0,1)*abs(sin(T*6))*1.0 6
S 48+12*cos(T*3.5) 28+12*sin(T*2.0) 28+20*cos(T*1.8) clamp(T-28,0,1)*abs(sin(T*7))*1.0 8

-- Surface highlights
B 48 40 28 8 1 8 clamp(T-25,0,1)*abs(sin(T*3+0.5))*8
B 36 28 28 1 8 8 clamp(T-25.5,0,1)*abs(sin(T*3+1))*8
B 60 28 28 1 8 8 clamp(T-26,0,1)*abs(sin(T*3+1.5))*8
B 48 28 40 8 8 1 clamp(T-26.5,0,1)*abs(sin(T*3+2))*8